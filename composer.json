{
    "name": "andre/baseapp",
    "description": "Projeto base (framework proprio) em PHP puro: MVC, RBAC, multi-tenant opcional, auditoria e middlewares. Sem regras de negocio - ponto de partida para novos projetos.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
