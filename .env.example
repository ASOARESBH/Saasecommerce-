# ============================================================
# BASEAPP — Variaveis de Ambiente
# Copie este arquivo para .env e preencha os valores
# ============================================================

# Aplicacao
APP_NAME="PHP Padrao App"
APP_ENV=production
APP_URL=http://localhost
APP_DEBUG=false
SESSION_TIMEOUT=3600

# Banco de Dados
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=seuusuario_phppadrao
DB_USERNAME=seuusuario_dbuser
DB_PASSWORD=sua_senha_forte

# Seguranca
APP_SECRET=troque_por_uma_chave_aleatoria_de_32_chars

# E-mail (opcional — usado se voce adicionar envio de e-mails ao projeto)
MAIL_HOST=smtp.exemplo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@exemplo.com
MAIL_FROM_NAME="Base App"

# Armazenamento
UPLOAD_MAX_SIZE=20M
