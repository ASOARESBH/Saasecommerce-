# SAAS ECOMMERCE — Variáveis de Ambiente
# Copie para .env e preencha os valores reais por ambiente.

APP_NAME="SaaS E-commerce"
APP_ENV=development
APP_URL=http://localhost
APP_DEBUG=true
APP_TIMEZONE=America/Sao_Paulo
SESSION_TIMEOUT=3600

# Banco de dados
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=saas_ecommerce
DB_USERNAME=seuusuario_dbuser
DB_PASSWORD=sua_senha_forte

# Segurança
APP_SECRET=gere_uma_chave_aleatoria_com_32_ou_mais_caracteres
API_RATE_LIMIT=120
WEBHOOK_RATE_LIMIT=60
CORS_ALLOWED_ORIGINS=https://exemplo.com

# Integrações e processamento de eventos
INTEGRATION_CONNECT_TIMEOUT=5
INTEGRATION_TIMEOUT=20
INTEGRATION_MAX_RETRIES=5
OUTBOX_BATCH_SIZE=25
OUTBOX_WORKER_SECRET=troque_por_um_segredo_de_worker

# E-mail (opcional)
MAIL_HOST=smtp.exemplo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@exemplo.com
MAIL_FROM_NAME="SaaS E-commerce"

# Armazenamento
UPLOAD_MAX_SIZE=20M

# Compatibilidade com o endpoint legado de CNPJ
CNPJ_CACHE_TTL_HOURS=24
CNPJ_RATE_LIMIT_MAX=10
CNPJ_RATE_LIMIT_SECS=60
CNPJ_PROVIDERS=brasilapi,receitaws,cnpja
CNPJA_TOKEN=
